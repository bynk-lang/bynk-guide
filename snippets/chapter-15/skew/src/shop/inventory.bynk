context shop.inventory

uses shop.values
consumes bynk { Clock, Logger }
exports transparent { StockError, HoldError }

---
Why stock couldn't be reserved.
---
type StockError = enum { Insufficient }

---
Why a hold couldn't be committed: there is none for the order, because it
was never made or the sweeper has already released it.
---
type HoldError = enum { NoHold }

---
Stock set aside for one order while its payment is taken, and when.
---
type Hold = {
	order: OrderId,
	qty: Int,
	at: Instant,
}

---
A hold the sweeper has found too old.
---
type Stale = {
	order: OrderId,
	qty: Int,
}

---
How long a hold may stand. Placing an order takes a second or two, so a
hold this old belongs to a request that died between `reserve` and
`commit` or `release`.
---
fn holdFor() -> Duration {
	15.minutes
}

---
The stock of one product. `available` is what can still be sold; a
reservation moves units out of it into `holds`, keyed by order id and
stamped with the time, until the order commits them (sold) or releases
them (back to `available`). `received` is the warehouse's deliveries, by
their own ids, for 30 days. Whatever the handlers do, stock never goes
negative.
---
agent Inventory {
	key sku: Sku

	store available: Cell[Int]
	store holds: Map[String, Hold]
	store received: Log[String] @retain(30.days)

	invariant available_non_negative:
		available >= 0

	on call restock(qty: Quantity) -> Effect[Int] {
		let _ <- available.update((v) => v + qty)
		available
	}

	on call reserve(
		order: OrderId,
		qty: Quantity
	) -> Effect[Result[(), StockError]] given Clock {
		let already <- holds.contains(orderRef(order))
		if already {
			Ok(())
		} else {
			if available < qty {
				Err(Insufficient)
			} else {
				let now <- Clock.now()
				let _ <- available.update((v) => v - qty)
				let _ <- holds.put(orderRef(order), Hold {
					order: order,
					qty: qty,
					at: now,
				})
				Ok(())
			}
		}
	}

	---
	Stock a delivery once, however many times it arrives.
	---
	on call receive(
		delivery: String,
		qty: Quantity
	) -> Effect[Int] given Clock {
		let seen <- received
			.since(Instant.fromEpochMillis(0))
			.any((id) => id == delivery)
		if seen {
			available
		} else {
			let _ <- received.append(delivery)
			let _ <- available.update((v) => v + qty)
			available
		}
	}

	on call commit(order: OrderId) -> Effect[Result[(), HoldError]] {
		let held <- holds.get(orderRef(order))
		match held {
			None => Err(NoHold),
			Some(_) => {
				let _ <- holds.remove(orderRef(order))
				Ok(())
			},
		}
	}

	on call release(order: OrderId) -> Effect[Int] {
		let held <- holds.get(orderRef(order))
		match held {
			None => available,
			Some(h) => {
				let _ <- holds.remove(orderRef(order))
				let _ <- available.update((v) => v + h.qty)
				available
			},
		}
	}

	---
	Release every hold made before `cutoff`, in one commit, and return the
	units that came back.
	---
	on call releaseStale(cutoff: Instant) -> Effect[Int] {
		let stale <- holds.entries
			.filter((e) => e.value.at < cutoff)
			.map((e) => Stale { order: e.value.order, qty: e.value.qty })
			.collect()
		let units = stale.fold(0, (n, h) => n + h.qty)
		let _ <- stale.foldEff((), (u, h) => holds.remove(
			orderRef(h.order)
		))
		let _ <- available.update((v) => v + units)
		units
	}

	on call level() -> Effect[Int] {
		available
	}

	on call held() -> Effect[Int] {
		holds.values.fold(0, (n, h) => n + h.qty)
	}
}

---
Every sku that has ever been stocked. Durable Objects can't be listed, so
this is how the sweeper knows which `Inventory` instances to visit.
---
agent Catalogue {
	key id: String

	store skus: Map[String, Sku]

	on call add(sku: Sku) -> Effect[()] {
		let _ <- skus.put(skuRef(sku), sku)
	}

	on call all() -> Effect[List[Sku]] {
		skus.values.collect()
	}
}

---
The calls other contexts can make, through a Service Binding. `c` is the
name of the context that called.
---
service restock {
	on call(sku: Sku, qty: Quantity) -> Effect[Int] by c: Caller {
		let _ <- Catalogue("all").add(sku)
		Inventory(sku).restock(qty)
	}
}

service reserve {
	on call(
		sku: Sku,
		order: OrderId,
		qty: Quantity
	) -> Effect[Result[(), StockError]] by c: Caller {
		Inventory(sku).reserve(order, qty)
	}
}

service commit {
	on call(
		sku: Sku,
		order: OrderId
	) -> Effect[Result[(), HoldError]] by c: Caller {
		Inventory(sku).commit(order)
	}
}

service release {
	on call(sku: Sku, order: OrderId) -> Effect[Int] by c: Caller {
		Inventory(sku).release(order)
	}
}

service level {
	on call(sku: Sku) -> Effect[Int] by c: Caller {
		Inventory(sku).level()
	}
}

---
Every five minutes, release the holds older than `holdFor`. A request that
dies between reserving stock and settling the payment leaves its hold
behind; this gives those units back. The cutoff is measured from the
scheduled time, not the clock, so a late run releases the same holds an
on-time one would have.
---
service sweeper from cron {
	on schedule("*/5 * * * *") (
		at: Int
	) -> Effect[Result[(), String]] given Logger {
		let cutoff = Instant.fromEpochMillis(at) - holdFor()
		let skus <- Catalogue("all").all()
		let units <- skus.foldEff(0, (n, sku) => {
			let u <- Inventory(sku).releaseStale(cutoff)
			n + u
		})
		do if units > 0 { Logger.info("released \(units) held units") }
		Ok(())
	}
}

---
A delivery from the warehouse: its own id, and so many units of one sku.
---
type Delivery = {
	id: String,
	sku: Sku,
	qty: Quantity,
}

---
The warehouse's system announces each delivery on a Cloudflare Queue. The
queue delivers at least once and retries a message that fails, so the
inventory counts a delivery by its id and never stocks it twice.
---
service deliveries from queue("stock-deliveries") {
	on message(d: Delivery) -> Effect[QueueResult] {
		let _ <- Catalogue("all").add(d.sku)
		let _ <- Inventory(d.sku).receive(d.id, d.qty)
		Ack
	}
}
