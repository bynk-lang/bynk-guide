suite shop.orders

case "a line that fits its types is admitted" {
	let raw = "{\"sku\":\"widget\",\"qty\":3,\"cents\":2500}"
	expect Json.decode[OrderLine](raw) is Ok(_)
}

case "a zero quantity is refused" {
	let raw = "{\"sku\":\"widget\",\"qty\":0,\"cents\":2500}"
	expect Json.decode[OrderLine](raw) is Err(_)
}

case "an order's total is quantity times price" {
	let line = OrderLine {
		sku: skuFrom("widget"),
		qty: 3,
		cents: 2500,
	}
	expect total(line) is Ok(_)
}

case "an order over 100,000.00 is too large" {
	let line = OrderLine {
		sku: skuFrom("widget"),
		qty: 1000,
		cents: 20000,
	}
	expect total(line) is Err(TooLarge(_))
}

case "the route answers with the line it was given" {
	let line = OrderLine {
		sku: skuFrom("widget"),
		qty: 3,
		cents: 2500,
	}
	let r <- api.PUT("/orders/:id", orderIdFrom("o1"), line)
	expect r is Created(_)
}
